# Copy this file to .env and fill in what you need. .env is never committed to git.

# xAI Grok - AI explanations (https://console.x.ai -> API Keys)
XAI_API_KEY=
# Optional: model name; if it is not available for your key, the app picks one automatically
GROK_MODEL=grok-4

# Google Fact Check Tools API - published fact-checks (console.cloud.google.com -> enable "Fact Check Tools API" -> Credentials -> API key)
FACTCHECK_API_KEY=

# Password of admin@fnds.local, used only when the database is first created
FNDS_ADMIN_PASSWORD=admin123

# Optional overrides
# FNDS_DB=fnds.db
# FNDS_MODEL=model.pkl
# PORT=5000
